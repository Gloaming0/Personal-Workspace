# Browser-safe Supabase configuration. Never expose a service-role key here.
VITE_APP_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-development-anon-key
VITE_SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173

# CLI-only variables belong in an ignored .env.local or shell environment:
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# SUPABASE_TEST_USER_A_EMAIL=
# SUPABASE_TEST_USER_A_PASSWORD=
# SUPABASE_TEST_USER_B_EMAIL=
# SUPABASE_TEST_USER_B_PASSWORD=
